# OPENAI_API_KEY: Clé API officielle OpenAI (stockée de manière sécurisée côté serveur)
OPENAI_API_KEY=MY_OPENAI_API_KEY

# OPENAI_MODEL: Modèle OpenAI officiel le plus performant (gpt-4o = modèle flagship Omni haute précision, gpt-4.1, o3, o1)
OPENAI_MODEL=gpt-4o

# GEMINI_API_KEY: Clé API de secours
GEMINI_API_KEY=MY_GEMINI_API_KEY

# BASE_URL: URL racine de l'API Gemini
BASE_URL=https://generativelanguage.googleapis.com/


# GOOGLE_CLIENT_ID: Identifiant OAuth 2.0 Web Client ID Google Cloud
GOOGLE_CLIENT_ID=438563104660-t8bmjvsmt4dpl4elj7has3vsg7obfken.apps.googleusercontent.com

# GOOGLE_CLIENT_SECRET: Clé secrète client Google Cloud
GOOGLE_CLIENT_SECRET=MY_GOOGLE_CLIENT_SECRET

# RESEND_API_KEY: Clé API Resend pour notifications d'assistance
RESEND_API_KEY=MY_RESEND_API_KEY

# YOUTUBE_API_KEY: Clé YouTube Data API v3 pour actualités et vidéos éducatives
YOUTUBE_API_KEY=MY_YOUTUBE_API_KEY

